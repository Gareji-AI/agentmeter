# PayPal sandbox credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=
PAYPAL_SANDBOX_RECIPIENT=

# Optional separate business credentials for Payouts; otherwise use the app above.
PAYPAL_PAYOUT_CLIENT_ID=
PAYPAL_PAYOUT_CLIENT_SECRET=

# Public base URL for webhook delivery and the OAuth return path.
PUBLIC_BASE_URL=http://localhost:8787

# LLM (Gemini). Leave empty to run in deterministic narration mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: keep Gemini enabled only for widget intent (used by demo:record).
GEMINI_WIDGETS_ONLY=

# Server
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=
# Sandbox UI sign-in token. If blank, a random token is printed at startup.
DEMO_ACCESS_TOKEN=
# Set to 1 for a shared mock server: require operator sign-in, with isolated public workspaces.
# Sandbox servers always require operator sign-in.
PUBLIC_WORKSPACES=
# Copying this template opts into sandbox payout previews. Set to execute for test transfers.
PAYOUT_MODE=dry-run

# Optional analytics; without a licence the HTML table and local widgets remain usable.
AG_GRID_LICENSE_KEY=
AG_STUDIO_LICENSE_KEY=
